{
  "manifest_version": 3,
  "name": "Copetín WhatsApp",
  "version": "1.2.0",
  "permissions": ["scripting"],
  "description": "Abre el chat del contrato en tu pestaña existente de WhatsApp Web.",
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp@tucopetin.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [{
    "matches": ["https://tucopetin.com/*", "https://www.tucopetin.com/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
