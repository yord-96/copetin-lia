{
  "manifest_version": 3,
  "name": "Copetín WhatsApp",
  "version": "1.0.0",
  "description": "Abre el chat del contrato en tu pestaña existente de WhatsApp Web.",
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://tucopetin.com/*", "https://www.tucopetin.com/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
