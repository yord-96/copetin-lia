# Frontend React/Vite
# En produccion debe apuntar a tu backend Node en el VPS.
# Ejemplo con subdominio:
VITE_API_URL=

# Clave interna minima para proteger /__copetin_db.
# En produccion usa una clave larga y aleatoria, por ejemplo:
# openssl rand -base64 48
APP_INTERNAL_KEY=cambia-esta-clave-larga-y-segura

# Si compilas el frontend para hablar con el backend protegido,
# usa el mismo valor de APP_INTERNAL_KEY.
# Nota: al estar en el frontend esta clave no reemplaza una autenticacion real.
VITE_APP_INTERNAL_KEY=cambia-esta-clave-larga-y-segura

# Codigo interno para reset general. Usa un valor largo/no obvio en produccion.
RESET_SECURITY_CODE=cambia-este-codigo

# Backend Node/Express en VPS/cPanel
CORS_ORIGIN=http://localhost:5173,http://2.24.108.161,https://tudominio.com
JSON_LIMIT=64mb
APP_STATE_FILE=./data/app-state.json
PRODUCT_UPLOAD_DIR=./uploads/products
PRODUCT_IMAGE_MAX_BYTES=8388608
ATTENDANCE_UPLOAD_DIR=./uploads/attendance
ATTENDANCE_PHOTO_MAX_BYTES=1048576
DOCUMENT_PDF_CACHE_DIR=./data/generated-documents/pdf-cache
CHROMIUM_USER_DATA_DIR=./data/chromium-profile
CHROMIUM_DISK_CACHE_BYTES=52428800
CHROMIUM_MEDIA_CACHE_BYTES=10485760
PORT=4000

# PostgreSQL local / migracion gradual
DATABASE_URL=postgresql://copetin_local:copetin_local_password@localhost:5432/copetin_dev?schema=public
DATABASE_MODE=json
ACTIVE_COMPANY_CODE=COPETIN
SESSION_SECRET=cambia-este-session-secret-local
COOKIE_SECURE=false
DATABASE_LOGGING=false
POSTGRES_DB=copetin_dev
POSTGRES_USER=copetin_local
POSTGRES_PASSWORD=copetin_local_password
POSTGRES_PORT=5432
