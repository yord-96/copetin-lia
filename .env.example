# Frontend Render Static Site
# Debe apuntar al Web Service del backend en Render.
VITE_API_URL=https://copetin-api.onrender.com

# Backend Render Web Service
# Copia aqui el connection string de Neon solo para desarrollo local del backend.
# En Render se configura como Environment Variable, no se sube con valor real.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require
CORS_ORIGIN=http://localhost:5173,https://copetin-web.onrender.com
JSON_LIMIT=25mb
DB_POOL_MAX=5
APP_STATE_ID=copetin-main
