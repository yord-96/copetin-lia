# Frontend React/Vite
# En produccion debe apuntar a tu backend Node en el VPS.
# Ejemplo con subdominio:
VITE_API_URL=

# Clave interna minima para proteger /__copetin_db.
# En produccion usa una clave larga y aleatoria, por ejemplo:
# openssl rand -base64 48
APP_INTERNAL_KEY=cambia-esta-clave-larga-y-segura

# Si compilas el frontend para hablar con el backend protegido,
# usa el mismo valor de APP_INTERNAL_KEY.
# Nota: al estar en el frontend esta clave no reemplaza una autenticacion real.
VITE_APP_INTERNAL_KEY=cambia-esta-clave-larga-y-segura

# Codigo interno para reset general. Usa un valor largo/no obvio en produccion.
RESET_SECURITY_CODE=cambia-este-codigo

# Backend Node/Express en VPS/cPanel
CORS_ORIGIN=http://localhost:5173,http://2.24.108.161,https://tudominio.com
JSON_LIMIT=25mb
APP_STATE_FILE=./data/app-state.json
PORT=4000
